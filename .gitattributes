# Text files are normalised to LF in the repository.
* text=auto eol=lf

# The result tables are written by Python's csv module, whose lineterminator is
# hard-coded to CRLF.  Check them out as CRLF so that re-running a script
# reproduces the committed file exactly instead of showing a spurious diff.
*.csv text eol=crlf

# Binary result tables and assets must never be line-ending converted.
*.npz binary
*.png binary
*.pdf binary
*.eps binary
